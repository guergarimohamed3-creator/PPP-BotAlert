# ============================================================
# .env.example — Modèle de configuration PARTAGÉ
# ============================================================
# INSTRUCTION : Copier ce fichier en ".env" et adapter les valeurs.
# Le fichier ".env" réel ne doit JAMAIS être commité sur Git.
# ============================================================

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=mosquitto          # Nom du service dans docker-compose
MQTT_PORT=1883

# --- Base de données (TimescaleDB = PostgreSQL avec extension temps-réel) ---
POSTGRES_USER=botalert
POSTGRES_PASSWORD=botalert_secret
POSTGRES_DB=botalert_db
POSTGRES_HOST=timescaledb    # Nom du service dans docker-compose
POSTGRES_PORT=5432

# --- Paramètres métier : la bouteille ---
TARE_KG=14.0                 # Poids de la bouteille vide (en kg)
BOTTLE_CAPACITY_KG=12.0      # Quantité de gaz dans une bouteille pleine (en kg)

# --- Seuils d'alerte ---
LOW_GAS_THRESHOLD_PCT=15     # Alerte si gaz restant < 15%
LEAK_PPM_THRESHOLD=1000      # Alerte fuite si gaz_ppm > 1000

# --- Simulateur Fleet (Mohamed Guergari) ---
NUM_DEVICES=1                # Nombre de maisons simulées (100, 500, 1000 pour le fleet)
PUBLISH_INTERVAL_SEC=5       # Intervalle d'envoi des données (en secondes)

# --- Virtual Bottle (ElMehdi) ---
DEVICE_ID=home-001           # Identifiant de la bouteille simulée
SPEED_FACTOR=1               # Accélération : 60 = 1s réelle = 1 minute simulée
LEAK_MODE=false              # true = simuler une fuite (gas_ppm > 1000)

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secret
